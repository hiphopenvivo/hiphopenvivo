{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "hhv-v2.9.3-preview": false,
      "hhv-v2.9.4-preview": false,
      "hhv-v2.9.5-preview": false,
      "hhv-v2.9.6-preview": false,
      "hhv-v2.9.7-preview": false,
      "hhv-v2.9.8-unified": false,
      "hhv-v2.9.10-flyers-radio-banks": true
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/render2910" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
