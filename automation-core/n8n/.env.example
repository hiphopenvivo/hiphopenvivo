# Copiar como .env local. NO subir valores reales al repositorio.

N8N_VERSION=2.6.4
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5678/

POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CAMBIAR_LOCALMENTE
N8N_ENCRYPTION_KEY=GENERAR_UNA_CLAVE_LARGA_Y_UNICA

# Credenciales HHV: configurar dentro de n8n o como secretos del host.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APIFY_TOKEN=
GEMINI_API_KEY=
GOOGLE_DRIVE_CREDENTIALS_REF=
METRICOOL_TOKEN=
HHV_WORKER_ID=hhv-n8n-local
